@use std::fmt::Write;
@{
    let mode = context.get_data::<u8>("mode").copied().unwrap_or(0);
    let mut local = String::new();
    write!(&mut local, "value: {}", 42).unwrap();
    writer.write("before|");
    if mode == 1 {
        return Ok(String::from("early"));
    }
    if mode == 2 {
        return Ok(writer.into_string());
    }
    if mode == 3 {
        return Err(sbolt::types::error::RuntimeError::InvalidInput("early error".into(), "".into()));
    }
    if mode == 4 {
        @{@(format_args!("<em>{}</em>", 42))|@(1.25)|@(true)|@(-42)}
        return Ok(writer.into_string());
    }
    if mode == 6 {
        use sbolt::types::WriteTo as _;
        struct Specialized;
        impl sbolt::types::WriteTo for Specialized {
            fn write_to(&self, writer: &mut impl sbolt::types::Writer) {
                writer.write("specialized");
            }
        }
        impl std::fmt::Display for Specialized {
            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
                f.write_str("display")
            }
        }
        let borrowed = &Specialized;
        fn specialized_output(borrowed: &Specialized) -> String {
            let mut output = String::new();
            borrowed.write_to(&mut output);
            output
        }
        @{@(specialized_output(borrowed))}
        return Ok(writer.into_string());
    }
    if mode == 7 {
        [1, 2].iter().for_each(|value| {
            @{<p>@(value):@(format_args!("<em>{}</em>", value))</p>}
        });
        return Ok(writer.into_string());
    }
    if mode == 8 {
        let markup = sbolt::utils::raw("<b>&\"trusted\"</b>");
        let borrowed = &markup;
        let nested = &borrowed;
        let mut mutable = sbolt::utils::raw("<i>mutable</i>");
        let from_context = context.get_data::<sbolt::types::Raw<&'static str>>("markup");
        @{@(markup)|@(borrowed)|@(nested)|@(&mut mutable)|@(from_context)|@("<u>escaped</u>")}
        return Ok(writer.into_string());
    }
    if mode == 9 {
        let value = context.get_data::<String>("attribute");
        @{<p title="@(value)" data-note='}
        if let Some(value) = value {
            @{@(format_args!("{}{}", value, value))}
        }
        @{'>@(value)</p>}
        return Ok(writer.into_string());
    }
    if mode == 10 {
        let message = context.get_data::<String>("message");
        let score = context.get_data::<f64>("score");
        @{@(message)|@(score)|@(Some(format_args!("<em>{}</em>", 42)))|@(None::<String>)|@(None::<f64>)}
        return Ok(writer.into_string());
    }
}
@local
